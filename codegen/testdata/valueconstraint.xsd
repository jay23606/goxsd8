<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- An element's {value constraint} (§3.3.1), default or fixed, is
       accepted and not represented: each element below emits exactly as it
       would without one. greeting and version are top-level; record's
       local elements carry each variety, one of them optional; amount has
       simple content and a fixed value. An attribute use's effective value
       constraint (§3.5.4 key-evc) drops the pointer of an optional use, the
       post-schema-validation infoset supplying the attribute when it is
       absent (§3.4.4.2 key-dflt-att): lang is optional with a default, note
       optional and fixed, revision required and fixed, and currency, an
       <attribute ref>, takes the default its global declaration carries.
       The ref to the built-in xsi:noNamespaceSchemaLocation keeps its
       pointer despite its default, key-dflt-att clause 4 supplying
       nothing for it. -->
  <xs:attribute name="currency" type="xs:token" default="EUR"/>
  <xs:element name="greeting" type="xs:string" default="hello"/>
  <xs:element name="version" type="xs:int" fixed="2"/>
  <xs:complexType name="amount">
    <xs:simpleContent>
      <xs:extension base="xs:decimal"/>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="record">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:token" default="open"/>
        <xs:element name="kind" type="xs:string" fixed="note"/>
        <xs:element name="count" type="xs:int" minOccurs="0" default="0"/>
        <xs:element name="total" type="amount" fixed="1.5"/>
      </xs:sequence>
      <xs:attribute name="lang" type="xs:language" default="en"/>
      <xs:attribute name="note" type="xs:string" fixed="draft"/>
      <xs:attribute name="revision" type="xs:int" use="required" fixed="1"/>
      <xs:attribute ref="currency"/>
      <xs:attribute ref="xsi:noNamespaceSchemaLocation" default="a.xsd"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
