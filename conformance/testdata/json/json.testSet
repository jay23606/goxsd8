<?xml version="1.0" encoding="UTF-8"?>
<!-- The curated json-lane corpus (conformance/doc.go, "The curated JSON
     corpus"): one group per validate/jsonsrc arm, each with a valid and an
     invalid case. Every instanceTest is a json case assessed against its
     group's schemaTest documents; the schemaTest is not a case of its own.
     An invalid case's documentation opens "expects <rule>", the rule the
     engine charges it under, which TestJSONCorpusChargesItsNamedRules holds
     it to. -->
<testSet xmlns="http://www.w3.org/XML/2004/xml-schema-test-suite/"
         xmlns:xlink="http://www.w3.org/1999/xlink"
         name="goxsd8-json" contributor="goxsd8">
  <testGroup name="scalar">
    <annotation>
      <documentation>A scalar-valued member is its element's simple content: {"size":10} is &lt;size&gt;10&lt;/size&gt;.</documentation>
    </annotation>
    <schemaTest name="scalar">
      <schemaDocument xlink:href="order.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="scalar.v">
      <instanceDocument xlink:href="scalar.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="scalar-integer.v">
      <annotation>
        <documentation>A number's lexical form is its source text: 12345678901234567890 is an xs:integer, which a float64 round trip would not keep.</documentation>
      </annotation>
      <instanceDocument xlink:href="scalar-integer.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="scalar.i">
      <annotation>
        <documentation>expects cvc-type: "ten" is not an xs:integer (clause 3.1.3, String Valid; cvc-datatype-valid beneath it).</documentation>
      </annotation>
      <instanceDocument xlink:href="scalar.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="child">
    <annotation>
      <documentation>A member whose key is the local name of a child element declaration of the enclosing type is that child, in member order; an object value carries its children.</documentation>
    </annotation>
    <schemaTest name="child">
      <schemaDocument xlink:href="order.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="child.v">
      <annotation>
        <documentation>memo is implicitly contained through note's substitution group.</documentation>
      </annotation>
      <instanceDocument xlink:href="child.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="child.i">
      <annotation>
        <documentation>expects cvc-complex-content: item before size breaks the sequence (cvc-complex-type clause 1.4).</documentation>
      </annotation>
      <instanceDocument xlink:href="child.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="child-content.i">
      <annotation>
        <documentation>expects cvc-type: the grandchild sku "abc" fails the sku pattern (cvc-pattern-valid beneath it).</documentation>
      </annotation>
      <instanceDocument xlink:href="child-content.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="child-stray.i">
      <annotation>
        <documentation>expects cvc-complex-content: extra, a key no declaration or use of order's wildcard-free type carries, is the child extra in order's own namespace, which the sequence does not accept (cvc-complex-type clause 1.4).</documentation>
      </annotation>
      <instanceDocument xlink:href="child-stray.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="array">
    <annotation>
      <documentation>An array value is one child per item under the member's key, in item order.</documentation>
    </annotation>
    <schemaTest name="array">
      <schemaDocument xlink:href="order.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="array.v">
      <instanceDocument xlink:href="array.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="array.i">
      <annotation>
        <documentation>expects cvc-complex-content: a third item exceeds item's maxOccurs of 2 (cvc-complex-type clause 1.4).</documentation>
      </annotation>
      <instanceDocument xlink:href="array.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="array-empty.i">
      <annotation>
        <documentation>expects cvc-complex-content: an empty array is no item, below item's minOccurs of 1 (cvc-complex-type clause 1.4).</documentation>
      </annotation>
      <instanceDocument xlink:href="array-empty.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="attribute">
    <annotation>
      <documentation>A member whose key is the local name of an attribute use of the enclosing type is that attribute, under the use's expanded name: {"shipment":{"id":"s1","dest":"Oslo"}} is &lt;shipment id="s1"&gt;&lt;dest&gt;Oslo&lt;/dest&gt;&lt;/shipment&gt;. Attribute members lead the object.</documentation>
    </annotation>
    <schemaTest name="attribute">
      <schemaDocument xlink:href="attribute.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="attribute.v">
      <instanceDocument xlink:href="attribute.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="attribute-missing.i">
      <annotation>
        <documentation>expects cvc-complex-type: priority is presented and the required id is not (clause 3).</documentation>
      </annotation>
      <instanceDocument xlink:href="attribute-missing.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="attribute-type.i">
      <annotation>
        <documentation>expects cvc-attribute: priority "high" is not an xs:integer (clause 3, String Valid).</documentation>
      </annotation>
      <instanceDocument xlink:href="attribute-type.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="nil">
    <annotation>
      <documentation>A null value is an element carrying xsi:nil="true" and no children: {"qty":null} is &lt;qty xsi:nil="true"/&gt;, an array's null item one such repeat. Whether it is nilled is the engine's cvc-elt clause 3.</documentation>
    </annotation>
    <schemaTest name="nil">
      <schemaDocument xlink:href="nil.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="nil.v">
      <annotation>
        <documentation>qty and the second line item are nilled (cvc-elt clause 3.2.3), so their empty content is not read as an xs:integer (cvc-type clause 3.1.3).</documentation>
      </annotation>
      <instanceDocument xlink:href="nil.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="nil-not-nillable.i">
      <annotation>
        <documentation>expects cvc-elt: size is not nillable and carries xsi:nil (clause 3.1).</documentation>
      </annotation>
      <instanceDocument xlink:href="nil-not-nillable.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="nil-fixed.i">
      <annotation>
        <documentation>expects cvc-elt: unit is nilled under a fixed value constraint (clause 3.2.3.2). Mapped as an empty element without xsi:nil it would take the fixed value and be valid (clause 5.1).</documentation>
      </annotation>
      <instanceDocument xlink:href="nil-fixed.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="type">
    <annotation>
      <documentation>A "$xmlns" member leading an object binds prefixes for the element and its descendants; a "$type" member after it is the element's xsi:type: {"item":{"$xmlns":{"t":"urn:x"},"$type":"t:Derived"}} is &lt;item xmlns:t="urn:x" xsi:type="t:Derived"/&gt;. The members after "$type" are classified under the type that governs the element: at the root, the type it names wherever that resolves; below it, the "governed" group says.</documentation>
    </annotation>
    <schemaTest name="type">
      <schemaDocument xlink:href="type.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="type.v">
      <annotation>
        <documentation>Derived overrides Base (cvc-elt clause 4), and d and b, Derived's own attribute and child, are classified under it: under Base, which has neither and no wildcard, d would be a child element ahead of a.</documentation>
      </annotation>
      <instanceDocument xlink:href="type.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="type-unrelated.i">
      <annotation>
        <documentation>expects cvc-elt: Other is not validly substitutable for Base, so it does not override it (clause 4). c is classified under Other and assessed under Base, which governs, so cvc-complex-content is charged beside it.</documentation>
      </annotation>
      <instanceDocument xlink:href="type-unrelated.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="type-unresolved.i">
      <annotation>
        <documentation>expects cvc-attribute: t:Missing resolves to no type definition (clause 5), so the element has no instance-specified type and a, classified under Base, is valid.</documentation>
      </annotation>
      <instanceDocument xlink:href="type-unresolved.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="qname.v">
      <annotation>
        <documentation>q's prefix t is bound by its parent's "$xmlns".</documentation>
      </annotation>
      <instanceDocument xlink:href="qname.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="qname-unbound.i">
      <annotation>
        <documentation>expects cvc-type: q's prefix t is unbound, its parent's "$xmlns" binding u alone (clause 3.1.3; cvc-datatype-valid beneath it).</documentation>
      </annotation>
      <instanceDocument xlink:href="qname-unbound.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="governed">
    <annotation>
      <documentation>The members after a "$type" are classified under the type that governs the element: on an element an {open content} takes, whose name has a locally declared type L, the type "$type" names where it overrides L validly substitutable without limitation, and L where it does not, with no cvc-elt charge (key-governing-type-elem clauses 6 and 7). Each case's x is the second, the open content's.</documentation>
    </annotation>
    <schemaTest name="governed">
      <schemaDocument xlink:href="governed.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="governed-overriding.v">
      <annotation>
        <documentation>Xe overrides L, so b, Xe's own attribute, and k are classified under it.</documentation>
      </annotation>
      <instanceDocument xlink:href="governed-overriding.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="governed-local.v">
      <annotation>
        <documentation>X does not override L, so L governs x, uncharged, and k is L's child; classified under X, k would be X's attribute, which L does not carry.</documentation>
      </annotation>
      <instanceDocument xlink:href="governed-local.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="governed-overriding.i">
      <annotation>
        <documentation>expects cvc-complex-type: Xo overrides L and governs x, and k, a child of L that Xo drops, is classified under Xo as a child, which Xo's empty {content type} does not admit (clause 1.1).</documentation>
      </annotation>
      <instanceDocument xlink:href="governed-overriding.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="governed-blocked.v">
      <annotation>
        <documentation>x's declaration blocks extension, but the open content's x has no governing element declaration, so Xe overrides L without limitation and b is Xe's attribute (key-overrides clause 2).</documentation>
      </annotation>
      <instanceDocument xlink:href="governed-blocked.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="wildcard">
    <annotation>
      <documentation>A key no child declaration and no attribute use carries is named by the one namespace the type's wildcards enumerate: {"box":{"w":5}} is &lt;box xmlns="urn:goxsd8:json:wildcard"&gt;&lt;w&gt;5&lt;/w&gt;&lt;/box&gt; under a ##targetNamespace element wildcard. Admission and processContents are the engine's.</documentation>
    </annotation>
    <schemaTest name="wildcard">
      <schemaDocument xlink:href="wildcard.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="wildcard-element.v">
      <annotation>
        <documentation>w is the target namespace's w, strictly assessed against the top-level declaration; named without a namespace it would resolve none under the strict wildcard.</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-element.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="wildcard-element.i">
      <annotation>
        <documentation>expects cvc-type: the wildcard's w is governed by the top-level xs:integer declaration, and "five" is not one (clause 3.1.3).</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-element.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="wildcard-local.v">
      <annotation>
        <documentation>Under bag's ##local wildcard, q has no namespace and no declaration, and is laxly assessed; named in the target namespace, the wildcard would reject it.</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-local.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="wildcard-attribute.v">
      <annotation>
        <documentation>p is the target namespace's p, assessed against the top-level xs:integer declaration; named without a namespace, the {attribute wildcard} would reject it.</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-attribute.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="wildcard-attribute.i">
      <annotation>
        <documentation>expects cvc-attribute: the {attribute wildcard}'s p resolves the top-level xs:integer declaration, and "five" is not one (clause 3, String Valid).</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-attribute.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="wildcard-prefixed.i">
      <annotation>
        <documentation>expects cvc-complex-content: the prefixed key z:q is {urn:goxsd8:json:z}q, which bag's ##local wildcard does not admit (cvc-complex-type clause 1.4); its namespace is the key's, not the wildcard's.</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-prefixed.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="wildcard-prefixed-xml.i">
      <annotation>
        <documentation>expects cvc-complex-type: the prefixed key xml:lang is the attribute {http://www.w3.org/XML/1998/namespace}lang, att's {attribute wildcard} being its only wildcard, and its ##targetNamespace wildcard does not admit it (clause 2.2.2, cvc-wildcard).</documentation>
      </annotation>
      <instanceDocument xlink:href="wildcard-prefixed-xml.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="prefix">
    <annotation>
      <documentation>A prefixed key "p:local" is {uri}local, uri the binding of p in scope at the element it names, its own "$xmlns" included: {"p:doc":{"$xmlns":{"p":"urn:x"}}} is &lt;p:doc xmlns:p="urn:x"/&gt;. It chooses between expanded names an unprefixed key, matched by local name, declines between, and names a root no top-level declaration carries.</documentation>
    </annotation>
    <schemaTest name="prefix">
      <schemaDocument xlink:href="prefix.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="prefix-root.v">
      <annotation>
        <documentation>The root is this namespace's doc, through the root's own "$xmlns"; unprefixed, doc is carried by both namespaces' top-level declarations.</documentation>
      </annotation>
      <instanceDocument xlink:href="prefix-root.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="prefix-child.v">
      <annotation>
        <documentation>o:k is the other namespace's k, through the child's own "$xmlns"; unprefixed, k is carried by doc's local k and its reference to the other namespace's.</documentation>
      </annotation>
      <instanceDocument xlink:href="prefix-child.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="prefix-attribute.v">
      <annotation>
        <documentation>o:a is the other namespace's xs:string a, through doc's "$xmlns"; unprefixed, a is carried by doc's qualified xs:integer a and its reference to the other namespace's.</documentation>
      </annotation>
      <instanceDocument xlink:href="prefix-attribute.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="prefix-undeclared.v">
      <annotation>
        <documentation>No top-level declaration carries p:none, so the root has no declaration and is assessed under the xsi:type its "$type" presents, empty (cvc-assess-elt clause 1.2).</documentation>
      </annotation>
      <instanceDocument xlink:href="prefix-undeclared.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="prefix-undeclared-local.v">
      <annotation>
        <documentation>No top-level declaration carries none, so the root is the element none in no namespace, with no declaration, assessed under the xsi:type its "$type" presents, empty (cvc-assess-elt clause 1.2).</documentation>
      </annotation>
      <instanceDocument xlink:href="prefix-undeclared-local.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="prefix-child.i">
      <annotation>
        <documentation>expects cvc-type: p:k is this namespace's xs:integer k, and "x" is not one (clause 3.1.3); the other namespace's k would hold it.</documentation>
      </annotation>
      <instanceDocument xlink:href="prefix-child.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
  <testGroup name="cta">
    <annotation>
      <documentation>An object value under a declaration carrying a {type table} maps where its declared type and every type the table can select classify each member alike, and the engine assesses the element under the type the table selects (key-selected-type, key-cta-select). Each case reads otherwise under cta.xsd with tt's {type table} removed: the selection, not the mapping, decides it.</documentation>
    </annotation>
    <schemaTest name="cta">
      <schemaDocument xlink:href="cta.xsd"/>
      <expected validity="valid"/>
    </schemaTest>
    <instanceTest name="cta.v">
      <annotation>
        <documentation>kind "note" selects Item, which admits the child note; Plain, the declared type, has empty content and would not.</documentation>
      </annotation>
      <instanceDocument xlink:href="cta.v.json"/>
      <expected validity="valid"/>
    </instanceTest>
    <instanceTest name="cta.i">
      <annotation>
        <documentation>expects cvc-complex-content: kind "note" selects Item, whose required note is missing (cvc-complex-type clause 1.4); Plain, the declared type, would hold the element.</documentation>
      </annotation>
      <instanceDocument xlink:href="cta.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
    <instanceTest name="cta-type.i">
      <annotation>
        <documentation>expects cvc-elt: the {test} reads the xsi:type the "$type" member presents, c:Plain, and selects Item, which Plain does not ·override· (clause 4); Plain, the declared type, it would.</documentation>
      </annotation>
      <instanceDocument xlink:href="cta-type.i.json"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
</testSet>
